# --- raw corpora and derived caches -------------------------------------
# Raw audio is licence-restricted and never committed. Feature caches are
# large, regenerable, and protected from deletion by the phase rules.
# The .gitkeep exceptions keep the directory structure in a clean clone, which
# Phase 11's clean-clone acceptance depends on.
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
*.npy
*.npz
*.h5

# --- results ------------------------------------------------------------
# results/runs.jsonl IS committed: it is the provenance record every table
# and figure is generated from. Scratch outputs are not.
results/scratch/
results/*.tmp
results/*.bak

# --- third-party API caches ---------------------------------------------
# Crossref responses. Regenerable, and a stale copy would hide a correction
# that the publisher has since made, so it is deliberately not committed.
.cache/

# --- python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.tools/
output/
.template-inspect/

# --- editors / OS -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- latex --------------------------------------------------------------
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# Derived: rebuild with `ser manifest` (file_path is machine-local)
data/manifest.csv

# Per-run predictions: regenerable, and large in aggregate.
results/predictions/

# Stage shard outputs and worker logs. The Stage 1/2 shards really are merged
# into runs.jsonl. The 13-layer sweep shards are NOT -- only 180 of their 2340
# rows share ids with the grid -- so they are packaged into the tracked
# results/layer_sweep_v2.jsonl by tools/merge_layer_sweep.py, and that file is
# what analysis reads. The shards stay here as the original source.
results/shards/
logs/

# Scratch working directory: rendered page images for visual proof checks, a
# downloaded LaTeX toolchain, staging copies. 122 MB of it, and nothing here is
# an input to any result -- but it was NOT ignored, so `git add -A` would have
# committed all of it. Ignored now, before that happens.
tmp/

# pytest --basetemp directories from past sessions (see PROGRESS.md). Disposable
# temp fixtures; several were created with ACLs this account cannot read, so they
# are ignored rather than cleaned up automatically.
.pytest-*/
